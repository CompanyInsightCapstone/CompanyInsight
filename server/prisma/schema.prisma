// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  username     String        @unique
  email        String
  password     String
  watchlist    Watchlist[]
  UserSettings UserSettings?

  @@index([id], type: Hash)
  @@map("User")
}

model UserSettings {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  infiniteScroll Boolean  @default(true)

  @@index([userId], type: Hash)
  @@map("UserSettings")
}

model Company {
  id                String              @unique @default(cuid())
  symbol            String              @unique
  name              String
  exchange          String?
  assetType         String?
  ipoDate           String?
  delistingDate     String              @default("N/A")
  status            String?
  watchlist         Watchlist[]
  CompanyDetails    CompanyDetails[]
  CompanyNumericals CompanyNumericals[]
  @@id([id, symbol])
  @@index([symbol])
  @@map("Company")
}

model CompanyDetails {
  id            String    @unique @default(cuid())
  companyId     String
  companySymbol String
  lastUpdated   DateTime? @default(now())
  description   String?
  company Company @relation(fields: [companyId, companySymbol], references: [id, symbol], onDelete: Cascade)
}

model CompanyNumericals {
  id            String    @unique @default(cuid())
  companyId     String
  companySymbol String
  lastUpdated   DateTime? @default(now())
  rawClose      Float?
  close         Float?
  open          Float?
  high          Float?
  low           Float?
  volume        Float?
  simpleMovingAverage    Float?
  smaStartDate  DateTime?
  smaEndDate    DateTime?
  company       Company   @relation(fields: [companyId, companySymbol], references: [id, symbol], onDelete: Cascade)
}

model Watchlist {
  id                     String    @id @default(cuid())
  percentChangeThreshold Float     @default(5.0)
  previousPrice          Float?
  lastNotifiedTime       DateTime?
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId              String
  companySymbol          String
  company                Company   @relation(fields: [companyId, companySymbol], references: [id, symbol], onDelete: Cascade)
  @@index([userId, companyId])
  @@map("Watchlist")
}
